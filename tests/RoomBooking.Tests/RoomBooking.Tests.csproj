<Project Sdk="Microsoft.NET.Sdk">

  <!-- Модульные и интеграционные тесты -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RoomBooking.Tests</RootNamespace>
    <Description>Тесты NUnit для модуля бронирования аудиторий</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoomBooking.Core\RoomBooking.Core.csproj" />
    <ProjectReference Include="..\..\src\RoomBooking.Web\RoomBooking.Web.csproj" />
  </ItemGroup>

</Project>
