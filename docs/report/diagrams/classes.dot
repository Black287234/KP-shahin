digraph G {
  graph [rankdir=LR, fontname="Liberation Serif", bgcolor=white, nodesep=0.5, ranksep=0.9];
  node [shape=plain, fontname="Liberation Serif", fontsize=13];
  edge [fontname="Liberation Serif", fontsize=12, color="#0f5e5a", penwidth=1.3];
  Room [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#0f5e5a">
   <tr><td bgcolor="#0f5e5a"><font color="white"><b>Room</b> — аудитория</font></td></tr>
   <tr><td align="left" balign="left">Code — номер<br/>Building — корпус<br/>Seats — мест<br/>HasProjector — проектор<br/>IsOutOfService — на ремонте</td></tr></table>>];
  Res [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#0f5e5a">
   <tr><td bgcolor="#0f5e5a"><font color="white"><b>Reservation</b> — бронирование</font></td></tr>
   <tr><td align="left" balign="left">Start, End — время<br/>Organizer — ответственный<br/>Purpose — цель<br/>Attendees — участников<br/>CancelReason — причина отмены</td></tr>
   <tr><td align="left" bgcolor="#e3f0ef">Cancel() — отменить</td></tr></table>>];
  Slot [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#0f5e5a">
   <tr><td bgcolor="#0f5e5a"><font color="white"><b>TimeSlot</b> — интервал</font></td></tr>
   <tr><td align="left">Start, End</td></tr>
   <tr><td align="left" bgcolor="#e3f0ef">Overlaps() — пересекается?</td></tr></table>>];
  Pol [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#a12b24">
   <tr><td bgcolor="#a12b24"><font color="white"><b>BookingPolicy</b> — правила</font></td></tr>
   <tr><td align="left" bgcolor="#fbeceb">Book() — проверить и создать<br/>бронирование</td></tr></table>>];
  Room -> Res [label=" 1 : N", arrowhead=none];
  Res -> Slot [label=" время", style=dashed];
  Pol -> Res [label=" создаёт", style=dashed];
  {rank=same; Pol; Slot}
}
