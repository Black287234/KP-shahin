digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", bgcolor=white, nodesep=0.6, ranksep=0.45];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#0f5e5a", penwidth=1.5, fontname="Liberation Serif", fontsize=14, width=4.2, height=0.75];
  edge [color="#0f5e5a", penwidth=1.3, arrowsize=0.9];
  u  [label="Пользователь (браузер)", fillcolor="#e3f0ef"];
  p  [label="Страницы и JSON API\nаудитории, бронирование, расписание"];
  s  [label="Сервисы\nкаталог, бронирование, расписание"];
  c  [label="Правила (проект RoomBooking.Core)\nаудитория, бронирование, интервал"];
  d  [label="База данных SQLite", shape=cylinder, fillcolor="#e3f0ef", width=2.6];
  u -> p -> s;
  s -> c [label="  проверка правил", fontname="Liberation Serif", fontsize=12];
  s -> d [label="  чтение и запись", fontname="Liberation Serif", fontsize=12];
