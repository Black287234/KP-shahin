digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", bgcolor=white, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#0f5e5a", penwidth=1.3, fontname="Liberation Serif", fontsize=14];
  edge [color="#0f5e5a", penwidth=1.2];
  home [label="Главная — сводка на день", fillcolor="#e3f0ef"];
  r [label="Аудитории\nкаталог, карточка,\nрегистрация"];
  b [label="Бронирование\nновое, журнал,\nкарточка и отмена"];
  s [label="Расписание\nна день и на неделю"];
  f [label="Свободные\nаудитории"];
  home -> {r b s f};
  f -> b [style=dashed, constraint=false, label=" забронировать", fontname="Liberation Serif", fontsize=12];
}
