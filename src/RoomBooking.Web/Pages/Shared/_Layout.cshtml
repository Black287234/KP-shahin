<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Бронирование аудиторий</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="top">
        <div class="wrap">
            <a class="title" asp-page="/Index">Бронирование учебных аудиторий</a>
            <nav>
                <a asp-page="/Rooms/Index">Аудитории</a>
            </nav>
        </div>
    </header>
    <main class="wrap">
        <partial name="_Notice" />
        @RenderBody()
    </main>
    <footer><div class="wrap">ЧПОУ «Сургутский колледж предпринимательства» · 2026</div></footer>
</body>
</html>
