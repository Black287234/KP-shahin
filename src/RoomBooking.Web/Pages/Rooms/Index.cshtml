@page
@model RoomBooking.Web.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Аудитории";
}
<h1>Каталог аудиторий</h1>
<p class="sub">Всего аудиторий: @Model.Rooms.Count</p>
<table class="grid">
    <thead><tr><th>Номер</th><th>Корпус</th><th>Назначение</th><th>Мест</th><th>Проектор</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rooms)
    {
        <tr>
            <td><b>@r.Code</b></td>
            <td>@r.Building</td>
            <td>@r.Kind.Text()</td>
            <td>@r.Seats</td>
            <td>@(r.HasProjector ? "есть" : "нет")</td>
            <td><a asp-page="/Rooms/Card" asp-route-id="@r.Id">Карточка</a></td>
        </tr>
    }
    </tbody>
</table>
